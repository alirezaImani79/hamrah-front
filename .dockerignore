# Keep the build context small and prevent dev/local artefacts from leaking
# into the production image. The Dockerfile only needs source + lockfile.

node_modules
.next
.git
.gitignore
.gitattributes

# Dev env files must NOT be baked into the image — production NEXT_PUBLIC_*
# values are passed as build args in docker-compose.yml.
.env
.env.*
!.env.production

Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

README.md
AGENTS.md
CLAUDE.md
docs
.vscode
.idea
.DS_Store
coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
